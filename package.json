{
  "name": "neoterra-launcher",
  "version": "1.2.0",
  "description": "NeoTerra Minecraft Launcher",
  "main": "./out/main/index.js",
  "author": "NeoTerra",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:dir": "electron-builder --win --dir"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "adm-zip": "^0.6.0",
    "electron-updater": "^6.8.9",
    "minecraft-launcher-core": "^3.18.2"
  },
  "build": {
    "appId": "uz.neoterra.launcher",
    "productName": "NeoTerra Launcher",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "public/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "NeoTerra Launcher"
    }
  }
}